generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String     @id @default(cuid())
  uid       String     @unique
  email     String     @unique
  name      String
  premium   Boolean    @default(false)
  createdAt DateTime   @default(now())
  analyses  Analysis[]
  goals     Goal[]
  badges    Badge[]
  posts     Post[]
  comments  Comment[]
  likes     PostLike[]
}

model Analysis {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodType          String
  totalMinutes        Int
  apps                Json
  topCategories       Json
  recommendations     Json
  detoxScore          Int
  coreProblems        Json
  psychologicalCauses Json
  detoxStrategies     Json
  dailyRoutine        Json
  timePatterns        Json
  isPremium           Boolean  @default(false)
  sourceAnalysisIds   Json?
  createdAt           DateTime @default(now())
}

model Goal {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  targetMinutes Int
  startDate     DateTime
  endDate       DateTime
  status        String   @default("active")
  createdAt     DateTime @default(now())
}

model Badge {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name     String
  earnedAt DateTime @default(now())
  shared   Boolean  @default(false)
}

/* ── 11단계: 소셜 · 커뮤니티 ──────────────────────────────── */

model Post {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String     @default("text") // "text" | "badge"
  content      String
  badgeName    String? // type="badge"일 때 공유한 배지 이름
  likeCount    Int        @default(0) // 비정규화 — 피드 집계 쿼리 방지
  commentCount Int        @default(0)
  createdAt    DateTime   @default(now())
  comments     Comment[]
  likes        PostLike[]

  @@index([createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())

  @@index([postId, createdAt])
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}
